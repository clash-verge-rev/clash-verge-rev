{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/polyfills/*.js!",
    "scripts/check-contract-changes.mjs!",
    "scripts/react/scene.tsx!",
    "scripts/react/profiler.ts!",
    "scripts/react/boundaries.tsx!",
    "scripts/react/material.tsx!",
    "scripts/react/yaml.ts!"
  ],
  "project": ["src/**/*.{js,jsx,ts,tsx,sass,scss}!", "scripts/**/*.{js,mjs}!"],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved",
    "binaries",
    "exports",
    "types",
    "duplicates",
    "cycles"
  ],
  "ignoreBinaries": ["rustc", "cc"],
  "ignoreDependencies": ["lint-staged"],
  "ignoreIssues": {
    "src/types/generated/**": ["exports", "types"],
    "src/services/bindings.ts": ["types"]
  },
  "cycles": {
    "dynamicImports": true
  }
}
