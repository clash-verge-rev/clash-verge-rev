{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.clash-verge-rev.clash-verge-rev",
  "productName": "Clash Verge",
  "build": {
    "beforeBundleCommand": "node crates/clash-verge-widget/build/bundle.mjs"
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "frameworks": ["generated/widget/VergeWidgetBridge.dylib"],
      "files": {
        "PlugIns/VergeWidget.appex": "generated/widget/VergeWidget.appex"
      },
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "generated/widget/Host.entitlements",
      "dmg": {
        "background": "images/background.png",
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        },
        "windowPosition": {
          "x": 200,
          "y": 180
        }
      },
      "infoPlist": "generated/widget/Host.plist"
    }
  }
}
